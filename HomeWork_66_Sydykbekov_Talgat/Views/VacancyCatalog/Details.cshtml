@model Vacancy



@{
    ViewData["Title"] = Model.Title;
    var myResumes =
        ViewData["ResumeOptions"] as List<SelectListItem>
        ?? new List<SelectListItem>();
}

<div class="container mt-4">
    <h2 class="text-break">@Model.Title</h2>

    <div class="card mt-3">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Работодатель</dt>
                <dd class="col-sm-8 text-break">
                    <a asp-controller="Company"
                       asp-action="Details"
                       asp-route-id="@Model.EmployerId">
                        @Model.Employer.UserName
                    </a>
                </dd>

                <dt class="col-sm-4">Категория</dt>
                <dd class="col-sm-8">
                    @Model.Category.NameCategory
                </dd>

                <dt class="col-sm-4">Зарплата</dt>
                <dd class="col-sm-8">
                    @Model.Salary.ToString("N2")
                </dd>

                <dt class="col-sm-4">Опыт работы</dt>
                <dd class="col-sm-8">
                    От @Model.ExperienceFrom
                    до @Model.ExperienceTo лет
                </dd>

                @if (Model.PublishedAt.HasValue)
                {
                    <dt class="col-sm-4">Опубликована</dt>
                    <dd class="col-sm-8">
                        @Model.PublishedAt.Value.ToString("dd.MM.yyyy HH:mm") UTC
                    </dd>
                }

                <dt class="col-sm-4">Обновлена</dt>
                <dd class="col-sm-8">
                    @Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm") UTC
                </dd>
            </dl>

            <h4>Описание и требования</h4>

            <div class="text-break"
                 style="white-space: pre-wrap;">@Model.Description</div>
        </div>
    </div>
    <div>
        @if (User.IsInRole("User"))
        {
            @if (myResumes.Count == 0)
            {
                <p class="mt-3">
                    Чтобы откликнуться, сначала создайте резюме.
                </p>

                <a asp-controller="Resume"
                   asp-action="Create"
                   class="btn btn-primary">
                    Создать резюме
                </a>
            }
            else
            {
                <button type="button"
                        class="btn btn-success mt-3"
                        data-bs-toggle="modal"
                        data-bs-target="#applyModal">
                    Откликнуться
                </button>

                <div class="modal fade"
                     id="applyModal"
                     tabindex="-1"
                     aria-labelledby="applyModalTitle"
                     aria-hidden="true">

                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form asp-controller="JobApplication"
                                  asp-action="Create"
                                  method="post">

                                <input type="hidden"
                                       name="vacancyId"
                                       value="@Model.Id" />

                                <div class="modal-header">
                                    <h5 class="modal-title" id="applyModalTitle">
                                        Отклик на вакансию
                                    </h5>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal"
                                            aria-label="Закрыть">
                                    </button>
                                </div>

                                <div class="modal-body">
                                    <label for="applyResume" class="form-label">
                                        Выберите резюме
                                    </label>

                                    <select id="applyResume"
                                            name="resumeId"
                                            asp-items="myResumes"
                                            class="form-select"
                                            required>
                                        <option value="">Выберите резюме</option>
                                    </select>
                                </div>

                                <div class="modal-footer">
                                    <button type="button"
                                            class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Отмена
                                    </button>

                                    <button type="submit" class="btn btn-success">
                                        Отправить отклик
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    <a asp-controller="VacancyCatalog"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        К списку вакансий
    </a>
</div>