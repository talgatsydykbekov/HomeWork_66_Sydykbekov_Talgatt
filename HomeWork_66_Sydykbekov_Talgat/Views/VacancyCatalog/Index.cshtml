@model HomeWork_66_Sydykbekov_Talgat.ViewModels.VacancyListViewModel



@{
    ViewData["Title"] = "Вакансии";
}

<div class="container mt-4">
    <h2>Вакансии</h2>
    @if (Model.Vacancies.Count == 0)
    {
        <p>Опубликованных вакансий пока нет.</p>
    }
    <form asp-controller="VacancyCatalog"
          asp-action="Index"
          method="get"
          class="mb-4">
        <div class="mb-3">
            <label asp-for="Search" class="form-label">
                Название вакансии
            </label>

            <input asp-for="Search"
                   class="form-control"
                   placeholder="Например, разработчик" />
        </div>
        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">
                Категория
            </label>

            <select asp-for="CategoryId"
                    asp-items="Model.Categories"
                    class="form-select">
                <option value="">Все категории</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Применить
        </button>

        <a asp-controller="VacancyCatalog"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Сбросить
        </a>
        <div class="mb-3">
            <label asp-for="Sort" class="form-label">
                Сортировка
            </label>

            <select asp-for="Sort" class="form-select">
                <option value="updated">
                    Сначала недавно обновлённые
                </option>

                <option value="salaryAsc">
                    Зарплата: сначала меньшая
                </option>

                <option value="salaryDesc">
                    Зарплата: сначала большая
                </option>
            </select>
        </div>
    </form>
        @foreach (var vacancy in Model.Vacancies)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h4 class="card-title text-break">
                        <a asp-controller="VacancyCatalog"
                           asp-action="Details"
                           asp-route-id="@vacancy.Id"
                           class="stretched-link">
                            @vacancy.Title
                        </a>
                    </h4>

                    <p>
                        Зарплата:
                        @vacancy.Salary.ToString("N2")
                    </p>

                    <p>
                        Категория: @vacancy.Category.NameCategory
                    </p>

                    <p>
                        Работодатель:

                        <a asp-controller="Company"
                           asp-action="Details"
                           asp-route-id="@vacancy.EmployerId"
                           class="position-relative"
                           style="z-index: 2;">
                            @vacancy.Employer.UserName
                        </a>
                    </p>

                    @if (vacancy.PublishedAt.HasValue)
                    {
                        <p>
                            Опубликована:
                            @vacancy.PublishedAt.Value.ToString("dd.MM.yyyy HH:mm") UTC
                        </p>
                    }
                </div>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Страницы вакансий"
                 class="d-flex flex-wrap align-items-center gap-3">

                @if (Model.Page > 1)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.Page - 1)"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-search="@Model.Search"
                       asp-route-sort="@Model.Sort"
                       class="btn btn-outline-primary">
                        Назад
                    </a>
                }

                <span>
                    Страница @Model.Page из @Model.TotalPages
                </span>

                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.Page + 1)"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-search="@Model.Search"
                       asp-route-sort="@Model.Sort"
                       class="btn btn-outline-primary">
                        Далее
                    </a>
                }
            </nav>
        }
    
</div>