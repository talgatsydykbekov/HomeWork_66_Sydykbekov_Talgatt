<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Поиск работы</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/HomeWork_66_Sydykbekov_Talgat.styles.css"
          asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg bg-body border-bottom">
            <div class="container">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="navbar-brand fw-bold text-primary">
                    Поиск работы
                </a>
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Открыть меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a asp-controller="VacancyCatalog"
                               asp-action="Index"
                               class="nav-link">
                                Вакансии
                            </a>
                        </li>
                        @if (User.IsInRole("Employer"))
                        {
                            <li class="nav-item">
                                <a asp-controller="ResumeCatalog"
                                   asp-action="Index"
                                   class="nav-link">
                                    Найти сотрудников
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("User"))
                        {
                            <li class="nav-item">
                                <a asp-controller="JobApplication"
                                   asp-action="Index"
                                   class="nav-link">
                                    Мои отклики
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a asp-controller="Category"
                                   asp-action="Create"
                                   class="nav-link">
                                    Создать категорию
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex flex-wrap align-items-center
                                gap-2 py-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="User"
                               asp-action="Index"
                               class="btn btn-outline-primary btn-sm">
                                Мой профиль
                            </a>
                            <form asp-controller="Account"
                                  asp-action="LogOff"
                                  method="post"
                                  class="m-0">
                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">
                                    Выйти
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-outline-primary btn-sm">
                                Войти
                            </a>
                            <a asp-controller="Account"
                               asp-action="Register"
                               class="btn btn-primary btn-sm">
                                Регистрация
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1 pb-4">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>