@model Category

@{
    Layout = null;
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg rounded-3">
                <div class="card-header bg-success text-white text-center">
                    <h4>Новая категория</h4>
                </div>
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data" asp-controller="Category" asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        
                        <div class="mb-3">
                            <label asp-for="NameCategory" class="form-label">Название</label>
                            <input asp-for="NameCategory" class="form-control" />
                            <span asp-validation-for="NameCategory" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100">Создать</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>