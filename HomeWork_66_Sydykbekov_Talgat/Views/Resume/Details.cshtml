@model Resume


@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <h2 class="text-break">@Model.Title</h2>

    <div class="card mt-3">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Категория</dt>
                <dd class="col-sm-8">
                    @Model.Category.NameCategory
                </dd>

                <dt class="col-sm-4">Ожидаемая зарплата</dt>
                <dd class="col-sm-8">
                    @Model.ExpectedSalary.ToString("N2")
                </dd>

                <dt class="col-sm-4">Дата создания</dt>
                <dd class="col-sm-8">
                    @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm") UTC
                </dd>

                <dt class="col-sm-4">Дата обновления</dt>
                <dd class="col-sm-8">
                    @Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm") UTC
                </dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(Model.Telegram) ||
                 !string.IsNullOrWhiteSpace(Model.Email) ||
                 !string.IsNullOrWhiteSpace(Model.PhoneNumber) ||
                 !string.IsNullOrWhiteSpace(Model.FacebookUrl) ||
                 !string.IsNullOrWhiteSpace(Model.LinkedInUrl))
            {
                <h3 class="mt-4">Контакты</h3>

                <dl class="row text-break">
                    @if (!string.IsNullOrWhiteSpace(Model.Telegram))
                    {
                        <dt class="col-sm-4">Telegram</dt>
                        <dd class="col-sm-8">@Model.Telegram</dd>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                    {
                        <dt class="col-sm-4">Телефон</dt>
                        <dd class="col-sm-8">@Model.PhoneNumber</dd>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                    {
                        <dt class="col-sm-4">Facebook</dt>
                        <dd class="col-sm-8">@Model.FacebookUrl</dd>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                    {
                        <dt class="col-sm-4">LinkedIn</dt>
                        <dd class="col-sm-8">@Model.LinkedInUrl</dd>
                    }
                </dl>
            }
            <div>
                <a asp-controller="Resume"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary mt-3">
                    Редактировать
                </a>
            </div>
        </div>
        <h3 class="mt-4">Опыт работы</h3>

        <a asp-controller="WorkExperience"
           asp-action="Create"
           asp-route-resumeId="@Model.Id"
           class="btn btn-outline-primary mb-3">
            Добавить опыт работы
        </a>

        @if (Model.WorkExperiences.Count == 0)
        {
            <p>Опыт работы пока не указан.</p>
        }
        else
        {
            @foreach (var experience in Model.WorkExperiences
                              .OrderByDescending(w => w.StartYear)
                              .ThenByDescending(w => w.Id))
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5>@experience.Position</h5>

                        <p>@experience.CompanyName</p>

                        <p>
                            @experience.StartYear —
                            @(experience.EndYear?.ToString()
                              ?? "по настоящее время")
                        </p>

                        <div class="text-break"
                             style="white-space: pre-wrap;">@experience.Responsibilities</div>
                    </div>
                    <div>
                        <a asp-controller="WorkExperience"
                           asp-action="Edit"
                           asp-route-id="@experience.Id"
                           class="btn btn-outline-primary mt-2">
                            Редактировать
                        </a>
                    </div>
                    <form asp-controller="WorkExperience"
                          asp-action="Delete"
                          asp-route-id="@experience.Id"
                          method="post"
                          class="mt-2"
                          onsubmit="return confirm('Удалить эту запись опыта работы?');">

                        <button type="submit" class="btn btn-outline-danger">
                            Удалить
                        </button>
                    </form>
                </div>
            }
        }
    </div>

    <a asp-controller="User"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Вернуться в профиль
    </a>
</div>