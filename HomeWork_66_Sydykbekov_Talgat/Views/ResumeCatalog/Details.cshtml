@model Resume

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <h2 class="text-break">@Model.Title</h2>

    <dl class="row mt-3">
        <dt class="col-sm-4">Категория</dt>
        <dd class="col-sm-8">@Model.Category.NameCategory</dd>

        <dt class="col-sm-4">Ожидаемая зарплата</dt>
        <dd class="col-sm-8">
            @Model.ExpectedSalary.ToString("N2")
        </dd>

        <dt class="col-sm-4">Обновлено</dt>
        <dd class="col-sm-8">
            @Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm") UTC
        </dd>
    </dl>

    @if (!string.IsNullOrWhiteSpace(Model.Telegram) ||
         !string.IsNullOrWhiteSpace(Model.Email) ||
         !string.IsNullOrWhiteSpace(Model.PhoneNumber) ||
         !string.IsNullOrWhiteSpace(Model.FacebookUrl) ||
         !string.IsNullOrWhiteSpace(Model.LinkedInUrl))
    {
        <h3 class="mt-4">Контакты</h3>

        <dl class="row text-break">
            @if (!string.IsNullOrWhiteSpace(Model.Telegram))
            {
                <dt class="col-sm-4">Telegram</dt>
                <dd class="col-sm-8">@Model.Telegram</dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Email))
            {
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
            {
                <dt class="col-sm-4">Телефон</dt>
                <dd class="col-sm-8">@Model.PhoneNumber</dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
            {
                <dt class="col-sm-4">Facebook</dt>
                <dd class="col-sm-8">@Model.FacebookUrl</dd>
            }

            @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
            {
                <dt class="col-sm-4">LinkedIn</dt>
                <dd class="col-sm-8">@Model.LinkedInUrl</dd>
            }
        </dl>
    }

    <h3 class="mt-4">Опыт работы</h3>

    @if (Model.WorkExperiences.Count == 0)
    {
        <p>Опыт работы не указан.</p>
    }
    else
    {
        @foreach (var experience in Model.WorkExperiences
            .OrderByDescending(w => w.StartYear)
            .ThenByDescending(w => w.Id))
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="text-break">@experience.Position</h5>

                    <p class="text-break">@experience.CompanyName</p>

                    <p>
                        @experience.StartYear —
                        @(experience.EndYear?.ToString()
                            ?? "по настоящее время")
                    </p>

                    <div class="text-break"
                         style="white-space: pre-wrap;">@experience.Responsibilities</div>
                </div>
            </div>
        }
    }

    <h3 class="mt-4">Образование и курсы</h3>

    @if (Model.Educations.Count == 0)
    {
        <p>Образование и курсы не указаны.</p>
    }
    else
    {
        @foreach (var education in Model.Educations
            .OrderByDescending(e => e.StartYear)
            .ThenByDescending(e => e.Id))
        {
            <div class="card mb-3">
                <div class="card-body">
                    <p>
                        @(education.IsCourse
                            ? "Курс / повышение квалификации"
                            : "Образование")
                    </p>

                    <h5 class="text-break">@education.Program</h5>

                    <p class="text-break">
                        @education.InstitutionName
                    </p>

                    <p>
                        @education.StartYear —
                        @(education.EndYear?.ToString()
                            ?? "по настоящее время")
                    </p>
                </div>
            </div>
        }
    }
    @if (ViewData["VacancyOptions"] is List<SelectListItem> myVacancies)
    {
        @if (myVacancies.Count == 0)
        {
            <p class="mt-3">
                Чтобы начать переписку, создайте и опубликуйте вакансию.
            </p>

            <a asp-controller="User"
               asp-action="Index"
               class="btn btn-primary">
                Мои вакансии
            </a>
        }
        else
        {
            <button type="button"
                    class="btn btn-success mt-3"
                    data-bs-toggle="modal"
                    data-bs-target="#startChatModal">
                Начать переписку
            </button>

            <div class="modal fade"
                 id="startChatModal"
                 tabindex="-1"
                 aria-labelledby="startChatTitle"
                 aria-hidden="true">

                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-controller="EmployerApplication"
                              asp-action="Start"
                              method="post">

                            <input type="hidden"
                                   name="resumeId"
                                   value="@Model.Id" />

                            <div class="modal-header">
                                <h5 class="modal-title" id="startChatTitle">
                                    Выберите вакансию для обсуждения
                                </h5>

                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Закрыть">
                                </button>
                            </div>

                            <div class="modal-body">
                                <label for="chatVacancy" class="form-label">
                                    Ваша вакансия
                                </label>

                                <select id="chatVacancy"
                                        name="vacancyId"
                                        asp-items="myVacancies"
                                        class="form-select"
                                        required>
                                    <option value="">Выберите вакансию</option>
                                </select>
                            </div>

                            <div class="modal-footer">
                                <button type="button"
                                        class="btn btn-secondary"
                                        data-bs-dismiss="modal">
                                    Отмена
                                </button>

                                <button type="submit" class="btn btn-success">
                                    Открыть переписку
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    <a asp-controller="ResumeCatalog"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        К списку резюме
    </a>
</div>