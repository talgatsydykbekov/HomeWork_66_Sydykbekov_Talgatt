@model HomeWork_66_Sydykbekov_Talgat.ViewModels.ResumeListViewModel

@{
    ViewData["Title"] = "Резюме соискателей";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <div class="bg-body-tertiary rounded-4 p-4 p-md-5 mb-4">
                <h1 class="h2 fw-bold mb-2">
                    Найдите своего специалиста
                </h1>

                <p class="text-muted mb-0">
                    Выбирайте категорию, изучайте резюме
                    и обсуждайте вакансии с кандидатами.
                </p>
            </div>

            <div class="card rounded-4 mb-4">
                <div class="card-body p-4">
                    <form asp-controller="ResumeCatalog"
                          asp-action="Index"
                          method="get">

                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-md-7">
                                <label asp-for="CategoryId"
                                       class="form-label">
                                    Категория
                                </label>

                                <select asp-for="CategoryId"
                                        asp-items="Model.Categories"
                                        class="form-select">
                                    <option value="">Все категории</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-5">
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="submit"
                                            class="btn btn-primary">
                                        Применить
                                    </button>

                                    <a asp-controller="ResumeCatalog"
                                       asp-action="Index"
                                       class="btn btn-outline-secondary">
                                        Сбросить
                                    </a>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-between
                        align-items-center gap-2 mb-3">
                <h2 class="h4 mb-0">Резюме соискателей</h2>

                @if (Model.Resumes.Count > 0)
                {
                    <span class="small text-muted">
                        На странице: @Model.Resumes.Count
                    </span>
                }
            </div>

            @if (Model.Resumes.Count == 0)
            {
                <div class="card rounded-4">
                    <div class="card-body text-center py-5 px-4">
                        <h3 class="h5 mb-2">Резюме не найдены</h3>

                        <p class="text-muted mb-4">
                            Попробуйте выбрать другую категорию
                            или сбросить фильтр.
                        </p>

                        <a asp-controller="ResumeCatalog"
                           asp-action="Index"
                           class="btn btn-primary">
                            Все резюме
                        </a>
                    </div>
                </div>
            }
            else
            {
                @foreach (var resume in Model.Resumes)
                {
                    <div class="card rounded-4 mb-3">
                        <div class="card-body p-4">

                            <div class="row g-3">
                                <div class="col-12 col-md-8">
                                    <h3 class="h5 text-break mb-3">
                                        <a asp-controller="ResumeCatalog"
                                           asp-action="Details"
                                           asp-route-id="@resume.Id"
                                           class="stretched-link text-decoration-none">
                                            @resume.Title
                                        </a>
                                    </h3>

                                    <span class="badge bg-body-tertiary
                                                 text-body border text-wrap text-start">
                                        @resume.Category.NameCategory
                                    </span>
                                </div>

                                <div class="col-12 col-md-4 text-md-end">
                                    <div class="small text-muted mb-1">
                                        Ожидаемая зарплата
                                    </div>

                                    <div class="fs-5 fw-semibold">
                                        @resume.ExpectedSalary.ToString("N2")
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap justify-content-between
                                        align-items-center gap-2 border-top pt-3 mt-3">
                                <span class="small text-muted">
                                    Обновлено:
                                    @resume.UpdatedAt.ToString("dd.MM.yyyy HH:mm") UTC
                                </span>

                                <span class="small text-primary">
                                    Посмотреть резюме →
                                </span>
                            </div>

                        </div>
                    </div>
                }

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Страницы резюме"
                         class="d-flex flex-wrap justify-content-center
                                align-items-center gap-3 mt-4">

                        @if (Model.Page > 1)
                        {
                            <a asp-controller="ResumeCatalog"
                               asp-action="Index"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-categoryId="@Model.CategoryId"
                               class="btn btn-outline-primary">
                                Назад
                            </a>
                        }

                        <span class="small text-muted">
                            Страница @Model.Page из @Model.TotalPages
                        </span>

                        @if (Model.Page < Model.TotalPages)
                        {
                            <a asp-controller="ResumeCatalog"
                               asp-action="Index"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-categoryId="@Model.CategoryId"
                               class="btn btn-outline-primary">
                                Далее
                            </a>
                        }
                    </nav>
                }
            }

        </div>
    </div>
</div>