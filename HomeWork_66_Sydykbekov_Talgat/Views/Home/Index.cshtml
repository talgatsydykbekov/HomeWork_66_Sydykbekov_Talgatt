@{
    ViewData["Title"] = "Главная";
}

<div class="container py-5">
    <div class="bg-body-tertiary rounded-4 p-4 p-md-5">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9 text-center">
                <span class="badge bg-primary mb-3">
                    Работа и карьера
                </span>

                <h1 class="display-5 fw-bold mb-3">
                    Найдите свою следующую работу
                </h1>

                <p class="lead text-muted mb-4">
                    Просматривайте вакансии, находите сотрудников
                    и обсуждайте предложения напрямую.
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-controller="VacancyCatalog"
                       asp-action="Index"
                       class="btn btn-primary btn-lg">
                        Смотреть вакансии
                    </a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="User"
                           asp-action="Index"
                           class="btn btn-outline-secondary btn-lg">
                            Мой профиль
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-outline-secondary btn-lg">
                            Войти
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <div class="card rounded-4 mt-4">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between
                            align-items-center gap-3">
                    <div>
                        <h2 class="h5 mb-1">Категории</h2>
                        <p class="text-muted mb-0">
                            Управление категориями вакансий и резюме.
                        </p>
                    </div>

                    <a asp-controller="Category"
                       asp-action="Create"
                       class="btn btn-primary">
                        Создать категорию
                    </a>
                </div>
            </div>
        </div>
    }
</div>