@model HomeWork_66_Sydykbekov_Talgat.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Мой профиль";
}

<div class="container mt-4">
    <h2>Мой профиль</h2>

    @if (TempData["Success"] is string message)
    {
        <div class="alert alert-success" role="status">
            @message
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Логин</dt>
                <dd class="col-sm-9">@Model.User.UserName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.User.Email</dd>

                <dt class="col-sm-3">Телефон</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.User.PhoneNumber)
                        ? "Не указан"
                        : Model.User.PhoneNumber)
                </dd>
            </dl>

            <button type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#editProfileModal">
                Редактировать профиль
            </button>
        </div>
    </div>
    @if (User.IsInRole("Employer"))
    {
        <a asp-controller="Vacancy"
           asp-action="Create"
           class="btn btn-primary mb-3">
            Создать вакансию
        </a>
    }
    @if (User.IsInRole("User"))
    {
        <div class="d-flex flex-wrap justify-content-between
                    align-items-center gap-2 mb-3">
            <h3 class="mb-0">Мои резюме</h3>

            <a asp-controller="Resume"
               asp-action="Create"
               class="btn btn-success">
                Создать резюме
            </a>
        </div>

        @if (Model.Resumes.Count == 0)
        {
            <p>У вас пока нет резюме.</p>
        }
        else
        {
            @foreach (var resume in Model.Resumes)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">
                            @resume.Title
                        </h5>

                        <p class="card-text">
                            Ожидаемая зарплата:
                            @resume.ExpectedSalary.ToString("N2")
                        </p>

                        <p class="card-text">
                            Обновлено:
                            @resume.UpdatedAt.ToString("dd.MM.yyyy HH:mm") UTC
                        </p>
                    </div>
                    <div>
                        <a asp-controller="Resume"
                           asp-action="Details"
                           asp-route-id="@resume.Id"
                           class="btn btn-primary">
                            Посмотреть
                        </a>
                    </div>
                    <div>
                        <a asp-controller="Resume"
                           asp-action="Edit"
                           asp-route-id="@resume.Id"
                           class="btn btn-secondary">
                            Редактировать
                        </a>
                    </div>
                    <div>
                        <form asp-controller="Resume"
                              asp-action="Refresh"
                              asp-route-id="@resume.Id"
                              method="post"
                              class="mt-2">

                            <button type="submit" class="btn btn-outline-primary">
                                Обновить дату
                            </button>
                        </form>
                    </div>
                    <div>
                        <p>
                            Статус:
                            @(resume.IsPublished ? "Опубликовано" : "Не опубликовано")
                        </p>

                        <form asp-controller="Resume"
                              asp-action="SetPublication"
                              asp-route-id="@resume.Id"
                              method="post"
                              class="mt-2">

                            @if (resume.IsPublished)
                            {
                                <button type="submit"
                                        name="isPublished"
                                        value="false"
                                        class="btn btn-outline-secondary">
                                    Снять с публикации
                                </button>
                            }
                            else
                            {
                                <button type="submit"
                                        name="isPublished"
                                        value="true"
                                        class="btn btn-success">
                                    Опубликовать
                                </button>
                            }
                        </form>
                    </div>
                </div>
            }
        }
    }
</div>

<div class="modal fade"
     id="editProfileModal"
     tabindex="-1"
     aria-labelledby="editProfileTitle"
     aria-hidden="true">

    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="User"
                  asp-action="Edit"
                  method="post">

                <div class="modal-header">
                    <h5 class="modal-title" id="editProfileTitle">
                        Редактирование профиля
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Закрыть">
                    </button>
                </div>

                <div class="modal-body">
                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label for="editUserName" class="form-label">
                            Логин
                        </label>

                        @Html.TextBox(
                            "userName",
                            Model.User.UserName,
                            new
                            {
                                id = "editUserName",
                                @class = "form-control",
                                required = "required"
                            })
                    </div>

                    <div class="mb-3">
                        <label for="editEmail" class="form-label">
                            Email
                        </label>

                        @Html.TextBox(
                            "email",
                            Model.User.Email,
                            new
                            {
                                id = "editEmail",
                                @class = "form-control",
                                type = "email",
                                required = "required"
                            })
                    </div>

                    <div class="mb-3">
                        <label for="editPhone" class="form-label">
                            Телефон
                        </label>

                        @Html.TextBox(
                            "phoneNumber",
                            Model.User.PhoneNumber,
                            new
                            {
                                id = "editPhone",
                                @class = "form-control",
                                type = "tel",
                                required = "required"
                            })
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Отмена
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Сохранить
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (ViewData["OpenEditModal"] is true)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const element = document.getElementById("editProfileModal");
            bootstrap.Modal.getOrCreateInstance(element).show();
        });
    </script>
}